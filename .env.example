# ---------------------------------------------------------------------------
# HealthHubPro environment variables
#
# Copy to .env for local development:  cp .env.example .env
# Every variable below is OPTIONAL for local development - the app boots with
# seeded in-memory storage and an ephemeral session secret if none are set.
# ---------------------------------------------------------------------------

# Postgres connection string. When set, the app uses Postgres and data
# persists; when unset it falls back to seeded in-memory storage and the UI
# shows a "Demo mode" badge. Any Postgres works; Neon is what the deployment
# uses. Get one free at https://neon.com - no card required.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. REQUIRED in production, where the app
# refuses to start without it. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# SESSION_SECRET=""

# Port for the local API server. Defaults to 5000.
# PORT=5000

# Extra origins allowed by CORS, comma-separated. Not needed when the API and
# client are served from the same origin, which is the case on Vercel.
# CORS_ORIGIN="http://localhost:5173"
