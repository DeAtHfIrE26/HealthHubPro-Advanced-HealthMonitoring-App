# ---------------------------------------------------------------------------
# healthhubpro-showcase
#
# The library and the playground need no configuration: everything runs on
# synthetic data generated in the browser. This file exists so the variable
# NAMES are documented in one place, and because CI checks that no real
# values ever appear beside them.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Where the playground is published, used only for absolute links in docs.
# Leave unset for local development.
# PUBLIC_BASE_URL="https://example.com"

# Nothing else. In particular this repository has no database, no API and no
# session handling, so it has no DATABASE_URL and no SESSION_SECRET. Those
# belong to the private application.
